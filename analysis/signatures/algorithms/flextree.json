  "submission_claims":{"claimed_advantages":[{"category":"security","summary":"Claims conservative security from hash-function preimage/second-preimage assumptions without a new structured mathematical problem.","claim_strength":"formal","comparison_scope":"SPHINCS+ proof framework"},{"category":"compactness","summary":"Public keys are 40-128 bytes and 256-bit signatures are claimed 6%-14.7% smaller than compared SPHINCS+-SHAKE profiles.","claim_strength":"comparative","comparison_scope":"submission Table 4.3"},{"category":"flexibility","summary":"Variable layer heights, unequal OTS chain lengths and PORS+FP parameters provide fine-grained size/speed trade-offs.","claim_strength":"qualitative","comparison_scope":"hash-based design space"},{"category":"implementation","summary":"Supports hedged randomized signing by default and a deterministic mode when no random generator is available.","claim_strength":"qualitative","comparison_scope":"signing API"}],"limitations_and_constraints":[{"category":"signature_size","summary":"The submission explicitly identifies signature size as a primary drawback; signatures range from 9,580 to 117,296 bytes.","basis":"explicit_caveat"},{"category":"signing_performance","summary":"The submission explicitly identifies signing speed as a primary drawback; small-signature profiles require millions of hash calls.","basis":"explicit_caveat"},{"category":"hash_instantiation","summary":"The specification warns that submitted SM3-derived XOF instantiations are treated as ideal and may not actually reach claimed security because of Merkle-Damgard-related limitations.","basis":"explicit_caveat"},{"category":"retry_search","summary":"Signing searches counter values until the PORS+FP forced-pruning bound is satisfied.","basis":"derived_from_implementation_description"},{"category":"platform_benchmark_scope","summary":"Benchmarks use one Intel Core i5-1135G7 Ubuntu platform and an AVX2 build whose hash primitive itself was not optimized.","basis":"derived_from_test_setup"}]},
