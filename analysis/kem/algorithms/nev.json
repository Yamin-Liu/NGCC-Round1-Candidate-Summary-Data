  "submission_claims": {
    "claimed_advantages": [
      {
        "category": "compactness",
        "summary": "Public key and ciphertext each use one ring element; C* profiles further round ciphertexts for about 16.7% reduction.",
        "claim_strength": "quantified",
        "comparison_scope": "C* compressed versus uncompressed C variants",
        "source_refs": [
          "spec"
        ]
      },
      {
        "category": "security",
        "summary": "Randomized plaintext encoding is claimed to decouple worst-case decryption failure from the message.",
        "claim_strength": "qualitative",
        "comparison_scope": null,
        "source_refs": [
          "spec"
        ]
      },
      {
        "category": "implementation",
        "summary": "Power-of-two-friendly encoding and partial NTT implementations are provided for x86 and ARM.",
        "claim_strength": "qualitative",
        "comparison_scope": null,
        "source_refs": [
          "spec"
        ]
      }
    ],
    "limitations_and_constraints": [
      {
        "type": "explicit_in_submission",
        "summary": "Compact C* profiles rely on a heuristic independent rounding-error model and an additional rounding-based hardness assumption.",
        "source_refs": [
          "spec"
        ]
      },
      {
        "type": "explicit_in_submission",
        "summary": "All profiles have nonzero failure probability; recommended R profiles are chosen to hedge against possible NTRU attack improvements.",
        "source_refs": [
          "spec"
        ]
      },
      {
        "type": "explicit_caveat",
        "summary": "Uncompressed C variants sacrifice the 16.7% ciphertext saving but avoid the compact-profile rounding assumption.",
        "source_refs": [
          "spec"
        ]
      }
    ]
  },
