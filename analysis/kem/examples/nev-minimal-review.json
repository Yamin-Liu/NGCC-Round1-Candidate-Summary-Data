  "claims": {
    "advantages": [
      {"summary": "Public key and ciphertext each use one ring element; C* profiles further round ciphertexts for about 16.7% reduction.", "source_refs": ["spec"]},
      {"summary": "Randomized plaintext encoding is claimed to decouple worst-case decryption failure from the message.", "source_refs": ["spec"]},
      {"summary": "Power-of-two-friendly encoding and partial NTT implementations are provided for x86 and ARM.", "source_refs": ["spec"]}
    ],
    "limitations": [
      {"summary": "Compact C* profiles rely on a heuristic independent rounding-error model and an additional rounding-based hardness assumption.", "source_refs": ["spec"]},
      {"summary": "All profiles have nonzero failure probability; recommended R profiles hedge against possible NTRU attack improvements.", "source_refs": ["spec"]},
      {"summary": "Uncompressed C variants avoid the compact-profile rounding assumption but sacrifice the 16.7% ciphertext saving.", "source_refs": ["spec"]}
    ]
  },
